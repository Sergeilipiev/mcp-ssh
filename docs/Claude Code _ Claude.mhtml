async healthCheck(connectionId: string): Promise&lt;HealthCheckResult&gt; {
  const startTime =3D Date.now();
 =20
  try {
    // =D0=9F=D1=80=D0=BE=D0=B2=D0=B5=D1=80=D1=8F=D0=B5=D0=BC =D1=81=D0=BE=
=D0=B5=D0=B4=D0=B8=D0=BD=D0=B5=D0=BD=D0=B8=D0=B5
    const uptimeOutput =3D await this.executeCommand({=20
      connectionId,=20
