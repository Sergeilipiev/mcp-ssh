=D0=B5 response time =D0=B8 load
    let status: 'healthy' | 'degraded' | 'down' =3D 'healthy';
    if (responseTime &gt; 5000) status =3D 'degraded';
   =20
    return {
      connectionId,
      hostname: this.getConnection(connectionId).config.host,
      status,
      responseTime,
