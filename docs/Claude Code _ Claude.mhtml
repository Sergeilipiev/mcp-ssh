<pre class=3D"bg-bg-200 p-3 rounded overflow-x-auto mb-2" node=3D"[object O=
bject]"><code class=3D"language-typescript" node=3D"[object Object]">import=
 { Client } from 'ssh2';
import pLimit from 'p-limit';

class SSHConnectionPool {
  private pool: Array&lt;{ conn: Client; inUse: boolean }&gt; =3D [];
  private limit =3D pLimit(10);
 =20
  async initialize(poolSize: number =3D 10) {
    for (let i =3D 0; i &lt; poolSize; i++) {
      const conn =3D new Client();
      await new Promise((resolve) =3D&gt; {
        conn.on('ready', () =3D&gt; {
          this.pool.push({ conn, inUse: false });
          resolve(null);
        });
        conn.connect({
          host: process.env.SSH_HOST,
          port: 22,
          username: process.env.SSH_USER,
          privateKey: fs.readFileSync(process.env.SSH_KEY_PATH),
          keepaliveInterval: 30000,  // 30s keepalive
          readyTimeout: 30000
        });
      });
    }
  }
 =20
  getConnection(): Client {
    const available =3D this.pool.find(c =3D&gt; !c.inUse);
    if (!available) throw new Error('No connections available');
    available.inUse =3D true;
    return available.conn;
  }
 =20
  releaseConnection(conn: Client) {
    const item =3D this.pool.find(c =3D&gt; c.conn =3D=3D=3D conn);
    if (item) item.inUse =3D false;
  }
}
