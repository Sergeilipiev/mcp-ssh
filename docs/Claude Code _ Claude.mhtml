#!/usr/bin/env python3
import re

# Read file
with open('/home/user/mcp-ssh/src/tools/ssh.ts', 'r') as f:
    content =3D f.read()

# Tools that need JSON support (excluding ssh_connect which is already done=
)
tools_to_update =3D [
    'ssh_list_connections',
    'ssh_execute_command',
    'ssh_upload_file',
    'ssh_download_file',
]

# For ssh_list_connections
# Find the handler and add JSON support
ssh_list_pattern =3D r'(ssh_list_connections[\s\S]*?async \(\) =3D&gt; \{[\=
s\S]*?)(const formattedConnections =3D connections\.map\(conn =3D&gt; \s*th=
is\.formatConnectionInfo\(conn\)\s*\)\.join\("\\n---\\n"\);[\s\S]*?return \=
{\s*content: \[\{\s*type: "text",\s*text: `=E5=B7=B2=E4=BF=9D=E5=AD=98=E7=
=9A=84=E8=BF=9E=E6=8E=A5:\\n\\n\$\{formattedConnections\}`\s*\}\]\s*\};)'

match =3D re.search(ssh_list_pattern, content)
if match:
    replacement =3D match.group(1) + '''// Format based on response_format
          const responseFormat =3D arguments[0]?.response_format || 'markdo=
wn';
         =20
          if (responseFormat =3D=3D=3D 'json') {
            return {
              content: [{
                type: "text",
                text: JSON.stringify(ResponseFormatter.connectionsToJSON(co=
nnections), null, 2)
              }]
            };
          }
         =20
          ''' + match.group(2)
    content =3D content.replace(match.group(0), replacement)
    print("Updated ssh_list_connections")

# Write back
with open('/home/user/mcp-ssh/src/tools/ssh.ts', 'w') as f:
    f.write(content)

print("Partial JSON support added")
ENDPY

