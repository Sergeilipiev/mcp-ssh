#!/usr/bin/env python3
import re

# Read file
with open('/home/user/mcp-ssh/src/tools/ssh.ts', 'r') as f:
    content =3D f.read()

# List of all 23 tools
tools =3D [
    'ssh_connect', 'ssh_disconnect', 'ssh_list_connections', 'ssh_get_conne=
ction',
    'ssh_delete_connection', 'ssh_execute_command', 'ssh_background_execute=
',
    'ssh_stop_background', 'ssh_get_current_directory', 'ssh_upload_file',
    'ssh_download_file', 'ssh_batch_upload_files', 'ssh_batch_download_file=
s',
    'ssh_get_file_transfer_status', 'ssh_list_file_transfers',
    'ssh_list_active_sessions', 'ssh_list_background_tasks',
    'ssh_stop_all_background_tasks', 'ssh_create_terminal_session',
    'ssh_write_to_terminal', 'ssh_create_tunnel', 'ssh_close_tunnel',
    'ssh_list_tunnels'
]

count =3D 0

for tool_name in tools:
    # Find the schema object for this tool
    # Pattern: "tool_name", ... { schema }, async (params)
    pattern =3D rf'("{tool_name}",[\s\S]*?\{{[^{{]*?)(\}},\s*async)'
   =20
    matches =3D list(re.finditer(pattern, content))
    if not matches:
        # Try alternate pattern without async
        pattern =3D rf'("{tool_name}",[\s\S]*?\{{[^{{]*?)(\}},\s*\()'
        matches =3D list(re.finditer(pattern, content))
   =20
    if matches:
        match =3D matches[0]
        schema_block =3D match.group(1)
       =20
        # Check if response_format already exists
        if 'response_format' in schema_block:
            print(f"Skipped {tool_name} (already has response_format)")
            continue
       =20
        # Add response_format parameter before the closing }
        # Find last parameter (ends with .optional() or just identifier)
        new_schema =3D schema_block + ',\n        response_format: z.enum([=
"markdown", "json"]).optional().default("markdown")'
       =20
        # Replace in content
        content =3D content.replace(match.group(1), new_schema, 1)
        count +=3D 1
        print(f"Added response_format to {tool_name}")

# Write back
with open('/home/user/mcp-ssh/src/tools/ssh.ts', 'w') as f:
    f.write(content)

print(f"\nTotal tools updated: {count}")
ENDPY

