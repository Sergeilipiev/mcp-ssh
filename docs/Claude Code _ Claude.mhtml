<pre class=3D"bg-bg-200 p-3 rounded overflow-x-auto mb-2" node=3D"[object O=
bject]"><code class=3D"language-typescript" node=3D"[object Object]">import=
 LRU from 'lru-cache';
import { createClient } from 'redis';
import RedisLRU from 'redis-lru';

// L1: In-memory LRU (hot data)
const l1Cache =3D new LRU({ max: 10000, ttl: 60000 }); // 60s

// L2: Redis (distributed)
const redis =3D createClient();
const l2Cache =3D new RedisLRU(redis, {
  max: 50000,
  maxAge: 3600000, // 1h
  namespace: 'ssh-ops'
});

async function getCachedResult(server: string, command: string) {
  const key =3D `ssh:${server}:${hash(command)}`;
 =20
  // L1 check
  let result =3D l1Cache.get(key);
  if (result) return result; // &lt;1ms
 =20
  // L2 check
  result =3D await l2Cache.get(key);
  if (result) {
    l1Cache.set(key, result); // Promote to L1
    return result; // 10-50ms
  }
 =20
  // Execute SSH
  result =3D await executeSSH(server, command); // 500-2000ms
 =20
  // Cache in both layers
  l1Cache.set(key, result);
  await l2Cache.set(key, result);
 =20
  return result;
}
