ace ConnectionGroup {
  id: string;
  name: string;
  description?: string;
  connectionIds: string[];
  createdAt: Date;
}

class ConnectionGroupManager {
  private groups: ConnectionGroup[] =3D [];
 =20
  createGroup(name: string, connectionIds: string[]): ConnectionGroup {
    const group: ConnectionGroup =3D {
      id: crypto.randomUUID(),
      name,
      connectionIds,
      createdAt: new Date(),
    };
   =20
    this.groups.push(group);
    return group;
  }
 =20
  getGroup(nameOrId: string): ConnectionGroup | undefined {
    return this.groups.find(g =3D&gt;=20
      g.id =3D=3D=3D nameOrId || g.name =3D=3D=3D nameOrId
    );
  }
 =20
  executeOnGroup(groupName: string, command: string): Promise&lt;BatchExecu=
teResult&gt; {
    const group =3D this.getGroup(groupName);
    if (!group) {
      throw new Error(`Group not found: ${groupName}`);
    }
   =20
    return this.sshService.batchExecute({
      connectionIds: group.connectionIds,
      command,
      parallel: true,
    });
  }
}
